# Dev default in code is `/api` (Vite proxy → 127.0.0.1:3001). Prefer that locally.
# If you set a full URL, use the SAME hostname as the browser tab (localhost OR 127.0.0.1).
# VITE_API_URL=/api
# VITE_API_URL=http://localhost:3001
VITE_SITE_URL=https://jetsale.online
# When published, set full Chrome Web Store URL:
# VITE_CHROME_STORE_URL=https://chromewebstore.google.com/detail/...
VITE_CHROME_STORE_URL=
# Optional: same site key as API TURNSTILE_SITE_KEY (widget also loaded via /auth/antibot)
# VITE_TURNSTILE_SITE_KEY=

