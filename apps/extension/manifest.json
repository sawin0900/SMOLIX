{
  "manifest_version": 3,
  "name": "jetsale.online VPN",
  "version": "1.1.0",
  "description": "Безопасный доступ к интернету через jetsale.online",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "proxy",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "notifications"
  ],
  "host_permissions": [
    "https://jetsale.online/*",
    "http://jetsale.online/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "public/popup-premium.html",
    "default_title": "jetsale.online VPN",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "key": ""
}
