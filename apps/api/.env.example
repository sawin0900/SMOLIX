DATABASE_URL=postgresql://user:pass@localhost:5432/smolix_db
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=0

# Browser + extension allowlists (production: set both)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Stable ID from packed extension (apps/extension/.extension-key.txt)
ALLOWED_EXTENSION_IDS=epnpbngbmokgpepeofjffnafdbphgdhn
# Match the URL you open in the browser (localhost vs 127.0.0.1)
WEB_APP_URL=http://localhost:5173

# Optional: protect /db-health and /remnawave-health (required header X-Health-Key)
# INTERNAL_HEALTH_KEY=

# Rate limits / login lockout
# RATE_LIMIT_GLOBAL_MAX=200
# RATE_LIMIT_GLOBAL_WINDOW=1 minute
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MS=900000
# LOGIN_LOCK_MS=900000
# MAX_WEB_SESSIONS=5
# Enable only after HTTPS is live. On plain HTTP (IP deploy) leave unset/0.
# COOKIE_SECURE=1

# Registration antibot / referral abuse
# REGISTER_MIN_MS=2500
# REGISTER_MAX_MS=7200000
# REGISTER_IP_HOUR_MAX=3
# REGISTER_IP_DAY_MAX=8
# REFERRAL_IP_DAY_MAX=3
# REFERRAL_SAME_IP_DAY_MAX=2
# REFERRAL_DAILY_GRANT_MAX=10
# REFERRAL_REWARD_DAYS=7
# REFERRAL_MIN_AGE_MINUTES=30
# Cloudflare Turnstile (when SECRET set, register requires widget token)
# Create site at https://dash.cloudflare.com → Turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Admin / support security (comma-separated). Empty = allow all.
# ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Roles: ADMIN (full) | SUPPORT (read + extend; no block/refund/cancel by default)

# Remnawave / proxy (panel UI + API, e.g. https://panel.jetsale.online)
# Do NOT run eGames full install on a live panel — see scripts/ops/
REMWAVE_BASE_URL=
REMWAVE_API_TOKEN=
REMWAVE_TINYAUTH_X_API_KEY=
# Optional overrides (defaults baked into code for jetsale squad/node):
# REMWAVE_SQUAD_UUID=
# REMWAVE_PROXY_NODE_UUID=
# REMWAVE_PROVISIONING=1
# Subscription page domain (links like https://node.jetsale.online/<shortUuid>)
REMWAVE_SUB_PUBLIC_DOMAIN=node.jetsale.online
PROXY_CREDENTIALS_KEY=
PROXY_MANAGER_URL=
PROXY_MANAGER_TOKEN=
# Public proxy host checked by block-monitor (cheburcheck-style)
PROXY_PUBLIC_HOST=rassiya.jetsale.online
PROXY_PUBLIC_PORT=8443
# BLOCK_MONITOR=1
# BLOCK_MONITOR_INTERVAL_MS=300000

# YooKassa (optional — without keys mock checkout is used)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_USER=
YOOKASSA_WEBHOOK_PASS=

# SMTP (required for real emails: welcome, trial reminders, reset password)
# Beget example: smtp.beget.com / port 465 + SMTP_SECURE=true  OR  587 + false
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@jetsale.online
SMTP_PASS=
MAIL_FROM="jetsale.online <info@jetsale.online>"

